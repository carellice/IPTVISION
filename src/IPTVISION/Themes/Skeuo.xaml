<!--
    Stile skeuomorfico: si aggiunge dopo Theme.xaml (vedi App.OnStartup) e ne ridefinisce colori, superfici e stili
    con le stesse chiavi. Materiali: lino per lo sfondo, pelle per i pannelli, metallo spazzolato per la barra del titolo,
    plastica lucida per i pulsanti principali, campi incassati e manopole metalliche.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== Materiali ===================== -->
    <ImageBrush x:Key="LinenBrush" ImageSource="pack://application:,,,/Assets/skeuo/linen.png"
                TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,256,256" />
    <ImageBrush x:Key="LeatherBrush" ImageSource="pack://application:,,,/Assets/skeuo/leather.png"
                TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,256,256" />
    <ImageBrush x:Key="MetalBrush" ImageSource="pack://application:,,,/Assets/skeuo/metal-dark.png"
                TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,512,128" />

    <!-- ===================== Palette ===================== -->
    <Color x:Key="AccentColor">#3D82F5</Color>
    <Color x:Key="Accent2Color">#6FB2FF</Color>

    <ImageBrush x:Key="BgBrush" ImageSource="pack://application:,,,/Assets/skeuo/linen.png" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,256,256" />
    <ImageBrush x:Key="PanelBrush" ImageSource="pack://application:,,,/Assets/skeuo/leather.png" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,256,256" />

    <!-- Piastra in rilievo: più chiara in alto, come illuminata dall'alto -->
    <LinearGradientBrush x:Key="SurfaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3E4149" Offset="0" />
        <GradientStop Color="#2C2E34" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SurfaceHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4A4E57" Offset="0" />
        <GradientStop Color="#34373E" Offset="1" />
    </LinearGradientBrush>
    <!-- Premuto: incassato, più scuro in alto -->
    <LinearGradientBrush x:Key="SurfacePressedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1B1C20" Offset="0" />
        <GradientStop Color="#28292E" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="StrokeBrush" Color="#0E0F11" />
    <SolidColorBrush x:Key="StrokeStrongBrush" Color="#08090A" />
    <SolidColorBrush x:Key="TextBrush" Color="#F3F0E8" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#ABA69C" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#7A766E" />
    <SolidColorBrush x:Key="AccentBrush" Color="#3D82F5" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#403D82F5" />
    <SolidColorBrush x:Key="AccentSoftHoverBrush" Color="#553D82F5" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF6B6B" />
    <SolidColorBrush x:Key="StarBrush" Color="#FFCB45" />
    <SolidColorBrush x:Key="LiveBrush" Color="#FF3B30" />

    <!-- Plastica blu lucida: riflesso netto a metà altezza -->
    <LinearGradientBrush x:Key="BrandBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#8CC0FF" Offset="0" />
        <GradientStop Color="#4F94F8" Offset="0.48" />
        <GradientStop Color="#2A6EE6" Offset="0.5" />
        <GradientStop Color="#3C86F4" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrandPressedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2059C2" Offset="0" />
        <GradientStop Color="#2A67D6" Offset="0.5" />
        <GradientStop Color="#3378E6" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BrandStroke" Color="#163E8C" />

    <!-- Bordo delle piastre: filo di luce in alto, ombra sotto -->
    <LinearGradientBrush x:Key="PlateStroke" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#70757F" Offset="0" />
        <GradientStop Color="#1A1B1F" Offset="0.08" />
        <GradientStop Color="#0A0B0C" Offset="1" />
    </LinearGradientBrush>
    <!-- Bordo dei pozzetti incassati: scuro in alto, luce sul bordo inferiore -->
    <LinearGradientBrush x:Key="InsetStroke" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#030304" Offset="0" />
        <GradientStop Color="#141518" Offset="0.85" />
        <GradientStop Color="#4A4D55" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="InsetWellBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#121316" Offset="0" />
        <GradientStop Color="#1D1F23" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="InsetShadeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#8C000000" Offset="0" />
        <GradientStop Color="#00000000" Offset="0.22" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlossHighlight" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#40FFFFFF" Offset="0" />
        <GradientStop Color="#08FFFFFF" Offset="0.5" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <!-- Contenitore dei pulsanti segmentati: una scanalatura -->
    <LinearGradientBrush x:Key="SegmentTrackBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#141518" Offset="0" />
        <GradientStop Color="#202226" Offset="1" />
    </LinearGradientBrush>

    <!-- Manopola metallica -->
    <RadialGradientBrush x:Key="KnobBrush" Center="0.5,0.3" GradientOrigin="0.45,0.2" RadiusX="0.7" RadiusY="0.7">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#D9DCE2" Offset="0.45" />
        <GradientStop Color="#9CA1AB" Offset="1" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="KnobStroke" Color="#2A2C31" />

    <DropShadowEffect x:Key="CardEffect" BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.7" Color="Black" />
    <DropShadowEffect x:Key="PlateEffect" BlurRadius="5" ShadowDepth="1.5" Direction="270" Opacity="0.55" Color="Black" />
    <DropShadowEffect x:Key="KnobEffect" BlurRadius="4" ShadowDepth="1.5" Direction="270" Opacity="0.7" Color="Black" />
    <!-- Testo inciso: ombra scura sopra le lettere -->
    <DropShadowEffect x:Key="EngraveEffect" BlurRadius="0" ShadowDepth="1" Direction="90" Opacity="0.9" Color="Black" />

    <!-- ===================== Superfici delle schermate ===================== -->
    <ImageBrush x:Key="TitleBarBrush" ImageSource="pack://application:,,,/Assets/skeuo/metal-dark.png" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,512,128" />
    <LinearGradientBrush x:Key="TitleBarShade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#38FFFFFF" Offset="0" />
        <GradientStop Color="#0CFFFFFF" Offset="0.5" />
        <GradientStop Color="#33000000" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TitleBarEdge" Color="#000000" />
    <ImageBrush x:Key="LoginBgBrush" ImageSource="pack://application:,,,/Assets/skeuo/linen.png" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,256,256" />
    <!-- Luce dall'alto e angoli in ombra sopra il lino -->
    <RadialGradientBrush x:Key="BackdropGlowBrush" Center="0.5,0.15" GradientOrigin="0.5,0.05" RadiusX="0.85" RadiusY="1.0">
        <GradientStop Color="#1EFFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="0.55" />
        <GradientStop Color="#99000000" Offset="1" />
    </RadialGradientBrush>
    <ImageBrush x:Key="LoginCardBrush" ImageSource="pack://application:,,,/Assets/skeuo/leather.png" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,256,256" />
    <LinearGradientBrush x:Key="LoginCardStroke" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#70757F" Offset="0" />
        <GradientStop Color="#1A1B1F" Offset="0.08" />
        <GradientStop Color="#0A0B0C" Offset="1" />
    </LinearGradientBrush>
    <ImageBrush x:Key="TvBgBrush" ImageSource="pack://application:,,,/Assets/skeuo/linen.png" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,256,256" />
    <LinearGradientBrush x:Key="TvCardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#383B43" Offset="0" />
        <GradientStop Color="#25272C" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TvCardFocusBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4C5160" Offset="0" />
        <GradientStop Color="#30333B" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TvCardStroke" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#70757F" Offset="0" />
        <GradientStop Color="#1A1B1F" Offset="0.08" />
        <GradientStop Color="#0A0B0C" Offset="1" />
    </LinearGradientBrush>
    <DropShadowEffect x:Key="TvCardEffect" BlurRadius="18" ShadowDepth="5" Direction="270" Opacity="0.75" Color="Black" />
    <LinearGradientBrush x:Key="TvPillActiveBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4A4E57" Offset="0" />
        <GradientStop Color="#2E3036" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TvLegendBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F0303238" Offset="0" />
        <GradientStop Color="#F0181A1D" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="KeyCapBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#5A5E68" Offset="0" />
        <GradientStop Color="#33363D" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="KeyCapStroke" Color="#0A0A0C" />
    <!-- Filo della cucitura sulla pelle -->
    <SolidColorBrush x:Key="StitchBrush" Color="#66B8A78A" />

    <!-- Piastre e scanalature: i riquadri delle schermate prendono rilievo dal loro sfondo. -->
    <Style TargetType="Border">
        <Style.Triggers>
            <Trigger Property="Background" Value="{StaticResource SurfaceBrush}">
                <Setter Property="BorderBrush" Value="{StaticResource PlateStroke}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Effect" Value="{StaticResource PlateEffect}" />
            </Trigger>
            <Trigger Property="Background" Value="{StaticResource SegmentTrackBrush}">
                <Setter Property="BorderBrush" Value="{StaticResource InsetStroke}" />
                <Setter Property="BorderThickness" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== Base ===================== -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource SurfaceHoverBrush}" BorderBrush="{StaticResource PlateStroke}" BorderThickness="1"
                            CornerRadius="6" Padding="9,5" Margin="4,4,4,8" Effect="{StaticResource PlateEffect}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pulsante con icona: inciso nel materiale, una piastra appare sotto il mouse -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource EngraveEffect}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PlateStroke}" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfacePressedBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource InsetStroke}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StarButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
    </Style>

    <!-- Pulsanti della barra del titolo, sul metallo -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Foreground" Value="#D8DADF" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource EngraveEffect}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#24FFFFFF" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#40000000" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource EngraveEffect}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FF6E66" Offset="0" />
                                        <GradientStop Color="#D9281E" Offset="1" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#A8170F" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pulsante principale: plastica blu lucida -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="{StaticResource BrandBrush}" BorderBrush="{StaticResource BrandStroke}" BorderThickness="1"
                                CornerRadius="10" Effect="{StaticResource PlateEffect}" />
                        <Border x:Name="Shine" Margin="1" CornerRadius="9" BorderThickness="1">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#B3FFFFFF" Offset="0" />
                                    <GradientStop Color="#1AFFFFFF" Offset="0.5" />
                                    <GradientStop Color="#33FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                        </Border>
                        <Border x:Name="Hover" Background="White" Opacity="0" CornerRadius="10" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Effect="{StaticResource EngraveEffect}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="0.1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandPressedBrush}" />
                            <Setter TargetName="Shine" Property="Opacity" Value="0.3" />
                            <Setter TargetName="Hover" Property="Opacity" Value="0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pulsante secondario: piastra grigia in rilievo -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="#08090A" BorderThickness="1" Effect="{StaticResource PlateEffect}" />
                        <Border x:Name="Shine" Margin="1" CornerRadius="7" BorderThickness="1">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#40FFFFFF" Offset="0" />
                                    <GradientStop Color="#00FFFFFF" Offset="0.6" />
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                        </Border>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" Effect="{StaticResource EngraveEffect}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#575B65" Offset="0" />
                                        <GradientStop Color="#3C3F47" Offset="1" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfacePressedBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource InsetStroke}" />
                            <Setter TargetName="Shine" Property="Opacity" Value="0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
    </Style>

    <!-- ===================== Campi di testo: pozzetti incassati ===================== -->
    <Style x:Key="InputBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Glow" CornerRadius="11" Margin="-2" BorderThickness="2" BorderBrush="#8C3D82F5" Opacity="0" />
                        <Border x:Name="Bd" Background="{StaticResource InsetWellBrush}" CornerRadius="10"
                                BorderBrush="{StaticResource InsetStroke}" BorderThickness="1">
                            <Grid>
                                <Border Background="{StaticResource InsetShadeBrush}" CornerRadius="9" IsHitTestVisible="False" />
                                <TextBlock x:Name="Ph" Text="{TemplateBinding Tag}" Foreground="{StaticResource TextTertiaryBrush}"
                                           Margin="{TemplateBinding Padding}" Padding="3,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Ph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Glow" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PasswordInput" TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid>
                        <Border x:Name="Glow" CornerRadius="11" Margin="-2" BorderThickness="2" BorderBrush="#8C3D82F5" Opacity="0" />
                        <Border x:Name="Bd" Background="{StaticResource InsetWellBrush}" CornerRadius="10"
                                BorderBrush="{StaticResource InsetStroke}" BorderThickness="1">
                            <Grid>
                                <Border Background="{StaticResource InsetShadeBrush}" CornerRadius="9" IsHitTestVisible="False" />
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Glow" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="2,0,0,7" />
        <Setter Property="Effect" Value="{StaticResource EngraveEffect}" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#8E897F" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="2,22,0,10" />
        <Setter Property="Effect" Value="{StaticResource EngraveEffect}" />
    </Style>

    <!-- ===================== ScrollBar: cursore metallico ===================== -->
    <Style x:Key="ThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="T" CornerRadius="3" BorderBrush="#0A0B0C" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#6A6F7A" Offset="0" />
                                <GradientStop Color="#454952" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent" Width="10">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ThumbStyle}" Margin="2,2" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="8" />
                <Setter Property="MinHeight" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent" Height="8">
                                <Track x:Name="PART_Track">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ThumbStyle}" Margin="2,1" />
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== Chip categorie: tasti in rilievo ===================== -->
    <Style x:Key="ChipItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="{StaticResource SurfaceHoverBrush}" CornerRadius="15" Height="30" Padding="12,0"
                            BorderBrush="{StaticResource PlateStroke}" BorderThickness="1">
                        <ContentPresenter VerticalAlignment="Center" Effect="{StaticResource EngraveEffect}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrandStroke}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Righe: separate da una scanalatura ===================== -->
    <Style x:Key="ChannelItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Margin" Value="8,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10">
                            <Grid>
                                <Border x:Name="Bar" Width="4" HorizontalAlignment="Left" Margin="1,13" CornerRadius="2"
                                        Background="{StaticResource BrandBrush}" Visibility="Collapsed">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#3D82F5" Opacity="1" />
                                    </Border.Effect>
                                </Border>
                                <ContentPresenter />
                            </Grid>
                        </Border>
                        <!-- scanalatura: riga scura con il filo di luce sotto -->
                        <StackPanel x:Name="Groove" VerticalAlignment="Bottom" Margin="10,0,10,-2" IsHitTestVisible="False">
                            <Border Height="1" Background="#59000000" />
                            <Border Height="1" Background="#0DFFFFFF" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfacePressedBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource InsetStroke}" />
                            <Setter TargetName="Groove" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                            <Setter TargetName="Bd" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#4D3D82F5" Offset="0" />
                                        <GradientStop Color="#263D82F5" Offset="1" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#803D82F5" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Groove" Property="Visibility" Value="Hidden" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LibraryList" TargetType="ListBox">
        <Setter Property="ItemContainerStyle" Value="{StaticResource ChannelItem}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,2,0,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="False">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Slider: scanalatura, riempimento lucido, manopola metallica ===================== -->
    <ControlTemplate x:Key="SkeuoFill" TargetType="RepeatButton">
        <Grid Background="Transparent">
            <Border Height="6" CornerRadius="3" Background="{StaticResource BrandBrush}" BorderBrush="{StaticResource BrandStroke}"
                    BorderThickness="1" VerticalAlignment="Center" />
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="SkeuoRest" TargetType="RepeatButton">
        <Border Background="Transparent" />
    </ControlTemplate>
    <ControlTemplate x:Key="SkeuoKnob" TargetType="Thumb">
        <Grid>
            <Ellipse Fill="{StaticResource KnobBrush}" Stroke="{StaticResource KnobStroke}" StrokeThickness="1" Effect="{StaticResource KnobEffect}" />
            <Ellipse Width="4" Height="4" Fill="#8C9099" />
        </Grid>
    </ControlTemplate>

    <Style x:Key="VolumeSlider" TargetType="Slider">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="24" Background="Transparent">
                        <Border Height="8" CornerRadius="4" Background="#C0000000" BorderBrush="{StaticResource InsetStroke}" BorderThickness="1"
                                VerticalAlignment="Center" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" Template="{StaticResource SkeuoFill}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Template="{StaticResource SkeuoRest}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="18" Height="18" Template="{StaticResource SkeuoKnob}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SeekSlider" TargetType="Slider">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="Root" Height="22" Background="Transparent">
                        <Border Height="8" CornerRadius="4" Background="#C0000000" BorderBrush="{StaticResource InsetStroke}" BorderThickness="1"
                                VerticalAlignment="Center" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" Template="{StaticResource SkeuoFill}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Template="{StaticResource SkeuoRest}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Knob" Width="16" Height="16" Opacity="0" Template="{StaticResource SkeuoKnob}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Interruttore: binario incassato e levetta metallica ===================== -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" MinHeight="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Grid Grid.Column="1" Width="54" Height="26">
                            <Border x:Name="Track" CornerRadius="13" BorderBrush="{StaticResource InsetStroke}" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#141518" Offset="0" />
                                        <GradientStop Color="#2A2C31" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="On" CornerRadius="13" BorderBrush="{StaticResource BrandStroke}" BorderThickness="1"
                                    Background="{StaticResource BrandPressedBrush}" Opacity="0">
                                <TextBlock Text="I" Foreground="White" FontWeight="Bold" FontSize="12" Margin="11,0,0,0"
                                           VerticalAlignment="Center" HorizontalAlignment="Left" Effect="{StaticResource EngraveEffect}" />
                            </Border>
                            <TextBlock x:Name="OffMark" Text="O" Foreground="{StaticResource TextTertiaryBrush}" FontWeight="Bold" FontSize="11"
                                       Margin="0,0,10,0" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <Border Background="{StaticResource InsetShadeBrush}" CornerRadius="13" IsHitTestVisible="False" />
                            <Ellipse x:Name="Knob" Width="24" Height="24" HorizontalAlignment="Left" Margin="1,0,0,0"
                                     Fill="{StaticResource KnobBrush}" Stroke="{StaticResource KnobStroke}" StrokeThickness="1"
                                     Effect="{StaticResource KnobEffect}" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="On" Property="Opacity" Value="1" />
                            <Setter TargetName="OffMark" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,1,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Segmentati: tasti dentro una scanalatura ===================== -->
    <Style x:Key="SegmentButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Height="30" Margin="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource EngraveEffect}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PlateStroke}" />
                            <Setter TargetName="Bd" Property="Effect" Value="{StaticResource PlateEffect}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Schede TV / Film / Serie: il tasto attivo è blu lucido ===================== -->
    <Style x:Key="ModeTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Height="34">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" />
                        <Border x:Name="Shine" Margin="1" CornerRadius="7" BorderThickness="1" Visibility="Collapsed">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#A0FFFFFF" Offset="0" />
                                    <GradientStop Color="#10FFFFFF" Offset="0.5" />
                                    <GradientStop Color="#30FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                        </Border>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource EngraveEffect}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrandStroke}" />
                            <Setter TargetName="Bd" Property="Effect" Value="{StaticResource PlateEffect}" />
                            <Setter TargetName="Shine" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Menu contestuale: piastra con voce evidenziata blu ===================== -->
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource PlateStroke}" BorderThickness="1"
                            CornerRadius="10" Padding="5" MinWidth="220" Margin="0,0,8,10" Effect="{StaticResource CardEffect}">
                        <StackPanel IsItemsHost="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="10,0" Height="34">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrandStroke}" />
                            <Setter TargetName="Check" Property="Foreground" Value="White" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <StackPanel Margin="6,5">
                        <Border Height="1" Background="#80000000" />
                        <Border Height="1" Background="#14FFFFFF" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
