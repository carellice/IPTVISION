<!--
    Stile Dueffe (design system Dueffe): si aggiunge dopo Theme.xaml (vedi App.OnStartup) e ne ridefinisce colori,
    superfici, font e gli stili principali con le stesse chiavi. Fondo quasi nero con un alone oro, superfici calde con
    un filo di bordo oro al posto delle ombre, testo avorio, un solo accento oro (gradiente, testo scuro sopra),
    Bricolage Grotesque per i titoli e Inter per il testo, angoli morbidi (tasti 18, campi 16, card 20).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== Palette ===================== -->
    <Color x:Key="AccentColor">#FFD84D</Color>
    <Color x:Key="Accent2Color">#FFB800</Color>

    <RadialGradientBrush x:Key="BgBrush" Center="0.08,0" GradientOrigin="0.08,0" RadiusX="0.9" RadiusY="1.1">
        <GradientStop Color="#221D0D" Offset="0" />
        <GradientStop Color="#0B0A07" Offset="0.55" />
        <GradientStop Color="#050505" Offset="1" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="PanelBrush" Color="#E60B0A08" />
    <LinearGradientBrush x:Key="SurfaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1A1711" Offset="0" />
        <GradientStop Color="#11100D" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#242016" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#2E281A" />
    <SolidColorBrush x:Key="StrokeBrush" Color="#29FFDC80" />
    <SolidColorBrush x:Key="StrokeStrongBrush" Color="#57FFD84D" />
    <SolidColorBrush x:Key="TextBrush" Color="#FFFAF0" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B8AA8D" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#7E7461" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FFD84D" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#24FFD84D" />
    <SolidColorBrush x:Key="AccentSoftHoverBrush" Color="#33FFD84D" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#161006" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF9B85" />
    <SolidColorBrush x:Key="StarBrush" Color="#FFD84D" />
    <SolidColorBrush x:Key="LiveBrush" Color="#FF7A5C" />
    <LinearGradientBrush x:Key="BrandBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFD84D" Offset="0" />
        <GradientStop Color="#FFC21A" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TitleBarBrush" Color="#050505" />
    <SolidColorBrush x:Key="TitleBarShade" Color="Transparent" />
    <SolidColorBrush x:Key="TitleBarEdge" Color="#29FFDC80" />
    <RadialGradientBrush x:Key="LoginBgBrush" Center="0.5,0.3" GradientOrigin="0.5,0.3" RadiusX="0.75" RadiusY="0.85">
        <GradientStop Color="#2A2310" Offset="0" />
        <GradientStop Color="#050505" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="BackdropGlowBrush" Center="0.95,0.4" GradientOrigin="0.95,0.4" RadiusX="0.6" RadiusY="0.7">
        <GradientStop Color="#1FFFB800" Offset="0" />
        <GradientStop Color="#00FFB800" Offset="1" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="LoginCardBrush" Color="#F012100C" />
    <SolidColorBrush x:Key="LoginCardStroke" Color="#57FFD84D" />
    <RadialGradientBrush x:Key="TvBgBrush" Center="0.15,0" GradientOrigin="0.15,0" RadiusX="1.1" RadiusY="1.2">
        <GradientStop Color="#2A2310" Offset="0" />
        <GradientStop Color="#0B0A07" Offset="0.55" />
        <GradientStop Color="#050505" Offset="1" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="TvCardBrush" Color="#1A1711" />
    <SolidColorBrush x:Key="TvCardFocusBrush" Color="#2E281A" />
    <SolidColorBrush x:Key="TvCardStroke" Color="#29FFDC80" />
    <SolidColorBrush x:Key="TvPillActiveBrush" Color="#FFD84D" />
    <SolidColorBrush x:Key="InsetWellBrush" Color="#11100D" />
    <SolidColorBrush x:Key="TvLegendBrush" Color="#E6080705" />
    <SolidColorBrush x:Key="KeyCapBrush" Color="#1A1711" />
    <SolidColorBrush x:Key="KeyCapStroke" Color="#29FFDC80" />
    <SolidColorBrush x:Key="StitchBrush" Color="Transparent" />
    <SolidColorBrush x:Key="SegmentTrackBrush" Color="#11100D" />
    <SolidColorBrush x:Key="CategoryTileBrush" Color="#1A1711" />
    <SolidColorBrush x:Key="CategoryGlyphBrush" Color="#FFD84D" />

    <!-- Font del design system, inclusi nell'app (istanze statiche: WPF non legge gli assi dei font variabili) -->
    <FontFamily x:Key="UiFont">/Assets/fonts/#Inter</FontFamily>
    <FontFamily x:Key="DisplayFont">/Assets/fonts/#Bricolage Grotesque</FontFamily>

    <!-- ===================== Pulsanti ===================== -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="#161006" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform"><Setter.Value><ScaleTransform /></Setter.Value></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="{StaticResource BrandBrush}" CornerRadius="18" />
                        <Border x:Name="Hover" Background="White" Opacity="0" CornerRadius="18" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="0.12" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.95" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.95" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><ElasticEase Oscillations="1" Springiness="5" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><ElasticEase Oscillations="1" Springiness="5" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform"><Setter.Value><ScaleTransform /></Setter.Value></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14"
                            BorderBrush="{StaticResource StrokeStrongBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfacePressedBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.95" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.95" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><ElasticEase Oscillations="1" Springiness="5" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><ElasticEase Oscillations="1" Springiness="5" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
    </Style>

    <!-- ===================== Campi di testo ===================== -->
    <Style x:Key="InputBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="#050505" CornerRadius="16"
                            BorderBrush="{StaticResource StrokeStrongBrush}" BorderThickness="1">
                        <Grid>
                            <TextBlock x:Name="Ph" Text="{TemplateBinding Tag}" Foreground="{StaticResource TextTertiaryBrush}"
                                       Margin="{TemplateBinding Padding}" Padding="3,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Ph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#8CFFD84D" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PasswordInput" TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd" Background="#050505" CornerRadius="16"
                            BorderBrush="{StaticResource StrokeStrongBrush}" BorderThickness="1">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#8CFFD84D" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="2,0,0,7" />
    </Style>

    <!-- Titolo di sezione: Bricolage, avorio, senza maiuscolo urlato -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="2,24,0,10" />
    </Style>

    <!-- ===================== ScrollBar ===================== -->
    <Style x:Key="ThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="T" Background="#40FFD84D" CornerRadius="3" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Background" Value="#70FFD84D" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="T" Property="Background" Value="#FFD84D" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent" Width="10">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ThumbStyle}" Margin="3,2" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="8" />
                <Setter Property="MinHeight" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent" Height="8">
                                <Track x:Name="PART_Track">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ThumbStyle}" Margin="2,2" />
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== Chip categorie: pillola con filo d'oro, scelta in oro pieno ===================== -->
    <Style x:Key="ChipItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="#11100D" CornerRadius="16" Height="32" Padding="14,0"
                            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Foreground" Value="#161006" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Righe: card calde col filo d'oro ===================== -->
    <Style x:Key="ChannelItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Margin" Value="8,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="16" BorderBrush="Transparent" BorderThickness="1">
                        <Grid>
                            <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Margin="0,14" CornerRadius="2"
                                    Background="{StaticResource BrandBrush}" Visibility="Collapsed" />
                            <ContentPresenter />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#52FFD84D" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LibraryList" TargetType="ListBox">
        <Setter Property="ItemContainerStyle" Value="{StaticResource ChannelItem}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,2,0,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="False">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Toggle switch oro ===================== -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" MinHeight="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Border x:Name="Track" Grid.Column="1" Width="42" Height="24" CornerRadius="12"
                                Background="#242016" BorderBrush="{StaticResource StrokeStrongBrush}" BorderThickness="1">
                            <Ellipse x:Name="Knob" Width="16" Height="16" Fill="{StaticResource TextSecondaryBrush}"
                                     HorizontalAlignment="Left" Margin="4,0,0,0" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource BrandBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="Knob" Property="Fill" Value="#161006" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Segmented: scelta in oro ===================== -->
    <Style x:Key="SegmentButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="12" Height="32" Margin="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandBrush}" />
                            <Setter Property="Foreground" Value="#161006" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Schede TV / Film / Serie ===================== -->
    <Style x:Key="ModeTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="14" Height="36">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandBrush}" />
                            <Setter Property="Foreground" Value="#161006" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
