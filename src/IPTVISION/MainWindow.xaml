<Window x:Class="IPTVISION.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IPTVISION"
        xmlns:m="clr-namespace:IPTVISION.Models"
        xmlns:vm="clr-namespace:IPTVISION.ViewModels"
        xmlns:svc="clr-namespace:IPTVISION.Services"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="IPTVISION"
        Width="1280" Height="760" MinWidth="880" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Segnaposto: il menu vero si costruisce in Library_ContextMenuOpening secondo l'elemento sotto il mouse. -->
        <ContextMenu x:Key="EmptyMenu" />
        <DataTemplate x:Key="VariantItemTemplate" DataType="{x:Type m:ArtworkItem}">
            <Grid Height="76" Margin="6,0" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="44" Height="62" CornerRadius="6" Background="#1C1F27" ClipToBounds="True">
                    <Grid>
                        <TextBlock Text="{Binding Initials}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasArt, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        <Image Source="{Binding Art}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="4" Padding="6,1" Margin="0,0,8,0"
                                Visibility="{Binding Quality, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="{Binding Quality}" FontSize="11" FontWeight="Bold" Foreground="#9DBBFF" />
                        </Border>
                        <Border Background="{StaticResource SurfacePressedBrush}" CornerRadius="4" Padding="6,1"
                                Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Iniziato" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding ItemName}" FontSize="13.5" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleRow" Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================= Barra del titolo ======================= -->
        <Grid x:Name="TitleBar" Background="{StaticResource PanelBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <Image Source="pack://application:,,,/Assets/logo.png" Width="18" Height="18"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="IPTVISION" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="13"
                           Margin="10,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="•" Foreground="{StaticResource TextTertiaryBrush}" Margin="10,0" VerticalAlignment="Center"
                           Visibility="{Binding NowPlayingTitle, Converter={StaticResource NullToVis}}" />
                <TextBlock Text="{Binding NowPlayingTitle}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center"
                            Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
                    <Button x:Name="TogglePanelButton" Style="{StaticResource IconButton}" Width="34" Height="30" FontSize="14"
                            Content="&#xE8A0;" ToolTip="Mostra/nascondi lista canali (L)" Click="TogglePanel_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Grid>
                        <Button Style="{StaticResource IconButton}" Width="34" Height="30" FontSize="14" Content="&#xE896;"
                                ToolTip="Download (film ed episodi offline)" Command="{Binding ToggleDownloadsCommand}"
                                WindowChrome.IsHitTestVisibleInChrome="True" />
                        <!-- Pallino: download in corso o in coda -->
                        <Ellipse Width="7" Height="7" Fill="#3DDC97" IsHitTestVisible="False"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,7,0"
                                 Visibility="{Binding HasActiveDownloads, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <Grid>
                        <Button Style="{StaticResource IconButton}" Width="34" Height="30" FontSize="14" Content="&#xE713;"
                                ToolTip="Impostazioni" Command="{Binding ToggleSettingsCommand}"
                                WindowChrome.IsHitTestVisibleInChrome="True" />
                        <!-- Pallino: c'è un aggiornamento disponibile -->
                        <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" IsHitTestVisible="False"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,7,0"
                                 Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </StackPanel>
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Riduci a icona" />
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Ingrandisci" />
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Chiudi" />
            </StackPanel>
        </Grid>

        <!-- ======================= Accesso ======================= -->
        <Grid Grid.Row="1" Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
            <Grid.Background>
                <RadialGradientBrush Center="0.5,0.32" GradientOrigin="0.5,0.32" RadiusX="0.7" RadiusY="0.8">
                    <GradientStop Color="#1A2A55" Offset="0" />
                    <GradientStop Color="#0A0B0F" Offset="1" />
                </RadialGradientBrush>
            </Grid.Background>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Border Width="420" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40"
                        Background="#E6111318" BorderBrush="{StaticResource StrokeStrongBrush}" BorderThickness="1"
                        CornerRadius="18" Padding="36,34">
                    <StackPanel>
                        <Image Source="pack://application:,,,/Assets/logo.png" Width="60" Height="60"
                               RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Left" />
                        <TextBlock Text="Benvenuto in IPTVISION" FontFamily="{StaticResource DisplayFont}" FontSize="24"
                                   FontWeight="SemiBold" Margin="0,20,0,4" />
                        <TextBlock Text="Accedi con il tuo account Xtream Codes per vedere i canali in diretta."
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,26" />

                        <TextBlock Text="SERVER" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ServerBox" Style="{StaticResource InputBox}" Tag="http://server:porta"
                                 Text="{Binding LoginServer, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Puoi anche incollare il link M3U completo: utente e password vengono letti da lì."
                                   Foreground="{StaticResource TextTertiaryBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="2,7,0,18" />

                        <TextBlock Text="NOME UTENTE" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="UserBox" Style="{StaticResource InputBox}" Tag="Nome utente"
                                 Text="{Binding LoginUsername, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,18" />

                        <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordInput}" />

                        <Border Margin="0,16,0,0" Padding="12,10" CornerRadius="8" Background="#1FFF5D6C"
                                Visibility="{Binding LoginError, Converter={StaticResource NullToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE783;" Style="{StaticResource Icon}" Foreground="{StaticResource DangerBrush}"
                                           FontSize="14" VerticalAlignment="Top" Margin="0,1,10,0" />
                                <TextBlock Text="{Binding LoginError}" Foreground="#FFB3BA" FontSize="12.5" TextWrapping="Wrap" MaxWidth="300" />
                            </StackPanel>
                        </Border>

                        <Button x:Name="LoginButton" Style="{StaticResource PrimaryButton}" Margin="0,24,0,0" Click="Login_Click"
                                IsDefault="True" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}">
                            <Grid>
                                <TextBlock Text="Accedi" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                                    <ContentControl Style="{StaticResource Spinner}" Width="44" Height="44" Margin="-12,-12,-4,-12">
                                        <ContentControl.LayoutTransform>
                                            <ScaleTransform ScaleX="0.4" ScaleY="0.4" />
                                        </ContentControl.LayoutTransform>
                                    </ContentControl>
                                    <TextBlock Text="{Binding BusyText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                            <TextBlock Text="La password resta cifrata su questo PC." Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="11.5" Margin="6,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

        <!-- ======================= Area principale ======================= -->
        <Grid x:Name="MainArea" Grid.Row="1" Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PanelColumn" Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ==== Pannello canali ==== -->
            <Border x:Name="Panel" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Ricerca unica: canali, film e serie -->
                    <Grid Margin="14,6,14,10">
                        <TextBox x:Name="SearchBox" Style="{StaticResource InputBox}" Height="40" FontSize="13.5" Padding="34,0,92,0"
                                 Tag="{Binding SearchPlaceholder}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" HorizontalAlignment="Left" Margin="13,0,0,0"
                                   Foreground="{StaticResource TextTertiaryBrush}" IsHitTestVisible="False" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
                            <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="10" Content="&#xE894;"
                                    Command="{Binding ClearSearchCommand}"
                                    Visibility="{Binding SearchText, Converter={StaticResource NullToVis}}" ToolTip="Cancella ricerca (Esc)" />
                            <Button x:Name="MicButton" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="13" Content="&#xE720;"
                                    Click="Mic_Click" ToolTip="Cerca con la voce (Ctrl+M)" />
                            <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="13" Content="&#xE82F;"
                                    Command="{Binding OpenQuizCommand}" ToolTip="Non sai cosa guardare? Rispondi a poche domande (Ctrl+G)" />
                        </StackPanel>
                    </Grid>

                    <!-- Sezioni: TV / Film / Serie -->
                    <Border Grid.Row="1" Margin="14,0,14,10" Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="3"
                            Visibility="{Binding IsSearchActive, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <UniformGrid Columns="3">
                            <RadioButton Style="{StaticResource ModeTab}" GroupName="mode" IsChecked="{Binding IsLiveMode}" ToolTip="TV in diretta (Ctrl+1)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                                    <TextBlock Text="TV" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource ModeTab}" GroupName="mode" IsChecked="{Binding IsMoviesMode}" ToolTip="Film (Ctrl+2)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B2;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                                    <TextBlock Text="Film" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource ModeTab}" GroupName="mode" IsChecked="{Binding IsSeriesMode}" ToolTip="Serie TV (Ctrl+3)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A9;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                                    <TextBlock Text="Serie TV" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>
                    </Border>

                    <!-- Ambito della ricerca: tutto oppure solo canali, film o serie -->
                    <Border Grid.Row="1" Margin="14,0,14,8" Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="2"
                            Visibility="{Binding IsSearchActive, Converter={StaticResource BoolToVis}}">
                        <UniformGrid Columns="4">
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="scope" IsChecked="{Binding IsScopeAll}" Content="Tutto" />
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="scope" IsChecked="{Binding IsScopeChannels}" Content="Canali" />
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="scope" IsChecked="{Binding IsScopeMovies}" Content="Film" />
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="scope" IsChecked="{Binding IsScopeSeries}" Content="Serie" />
                        </UniformGrid>
                    </Border>

                    <!-- Intestazione della categoria aperta -->
                    <Grid Grid.Row="2" Margin="8,0,14,4" Visibility="{Binding ShowCategoryHeader, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource IconButton}" Content="&#xE72B;" FontSize="13"
                                Command="{Binding CloseCategoryCommand}" ToolTip="Torna alle categorie (Esc)" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectedCategory.Name}" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold"
                                   Margin="6,0,6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button x:Name="SortButton" Grid.Column="2" Style="{StaticResource IconButton}" Width="Auto" Click="Sort_Click"
                                ToolTip="Ordina">
                            <StackPanel Orientation="Horizontal" Margin="8,0">
                                <TextBlock Text="&#xE8CB;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SelectedSort.Label}" FontFamily="{StaticResource UiFont}" FontSize="12" Margin="6,0,0,0"
                                           VerticalAlignment="Center" MaxWidth="110" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                        <Border Grid.Column="3" Background="{StaticResource SurfaceBrush}" CornerRadius="9" Margin="4,0,0,0" Padding="1">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentButton}" GroupName="view" Width="32" ToolTip="Elenco"
                                             IsChecked="{Binding IsGridView, Converter={StaticResource InvertBool}}">
                                    <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                                </RadioButton>
                                <RadioButton Style="{StaticResource SegmentButton}" GroupName="view" Width="32" ToolTip="Griglia"
                                             IsChecked="{Binding IsGridView}">
                                    <TextBlock Text="&#xF0E2;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                                </RadioButton>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Elenco categorie (si sceglie prima la categoria) -->
                    <ListBox x:Name="CategoryList" Grid.Row="3" ItemsSource="{Binding Categories}" Style="{StaticResource LibraryList}"
                             Visibility="{Binding ShowCategoryList, Converter={StaticResource BoolToVis}}"
                             PreviewMouseLeftButtonUp="ChannelList_PreviewMouseLeftButtonUp" KeyDown="ChannelList_KeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:CategoryItem}">
                                <Grid Height="52" Margin="8,0,10,0" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource SurfaceBrush}">
                                        <TextBlock x:Name="Glyph" Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Margin="10,0,8,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}"
                                               VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="3" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="10"
                                               Foreground="{StaticResource TextTertiaryBrush}" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsFavorites}" Value="True">
                                        <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource StarBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsContinue}" Value="True">
                                        <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Risultati della ricerca unica -->
                    <ListBox x:Name="SearchList" ContextMenuOpening="Library_ContextMenuOpening" ContextMenu="{StaticResource EmptyMenu}" Grid.Row="2" Grid.RowSpan="2" ItemsSource="{Binding SearchResults}" Style="{StaticResource LibraryList}"
                             Visibility="{Binding IsSearchActive, Converter={StaticResource BoolToVis}}"
                             PreviewMouseLeftButtonUp="ChannelList_PreviewMouseLeftButtonUp" KeyDown="ChannelList_KeyDown">
                        <ListBox.Resources>
                            <DataTemplate DataType="{x:Type m:SearchHeader}">
                                <StackPanel Orientation="Horizontal" Margin="10,12,0,4">
                                    <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextTertiaryBrush}" />
                                    <TextBlock Text="{Binding Count}" FontSize="11.5" Margin="8,0,0,0" Foreground="{StaticResource TextTertiaryBrush}" Opacity="0.7" />
                                </StackPanel>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type m:SearchHit}">
                                <Grid Height="62" Margin="8,0,10,0" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="Thumb" Width="48" Height="36" CornerRadius="7" Background="#1C1F27" BorderBrush="#262A34" BorderThickness="1">
                                        <Grid>
                                            <TextBlock Text="{Binding Initials}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{Binding Item.Logo}" Stretch="Uniform" Margin="4" RenderOptions.BitmapScalingMode="HighQuality" />
                                            <Image Source="{Binding Item.Art}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" Visibility="{Binding Subtitle, Converter={StaticResource NullToVis}}" />
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsPoster}" Value="True">
                                        <Setter TargetName="Thumb" Property="Width" Value="36" />
                                        <Setter TargetName="Thumb" Property="Height" Value="52" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.Resources>
                    </ListBox>
                    <StackPanel Grid.Row="1" Grid.RowSpan="3" VerticalAlignment="Bottom" HorizontalAlignment="Center" Orientation="Horizontal" Margin="0,0,0,10"
                                Visibility="{Binding IsSearchCatalogLoading, Converter={StaticResource BoolToVis}}">
                        <ContentControl Style="{StaticResource Spinner}" Width="44" Height="44">
                            <ContentControl.LayoutTransform>
                                <ScaleTransform ScaleX="0.4" ScaleY="0.4" />
                            </ContentControl.LayoutTransform>
                        </ContentControl>
                        <TextBlock Text="Cerco anche in film e serie…" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>

                    <!-- Lista canali -->
                    <ListBox x:Name="ChannelList" Grid.Row="3" ItemsSource="{Binding VisibleChannels}"
                             Visibility="{Binding ShowChannelList, Converter={StaticResource BoolToVis}}"
                             ItemContainerStyle="{StaticResource ChannelItem}" Background="Transparent" BorderThickness="0"
                             Padding="0,2,0,8" HorizontalContentAlignment="Stretch"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="True"
                             PreviewMouseLeftButtonUp="ChannelList_PreviewMouseLeftButtonUp"
                             KeyDown="ChannelList_KeyDown">
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="False">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:Channel}">
                                <Grid Height="58" Margin="6,0,4,0" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="NumText" Text="{Binding Num}" Foreground="{StaticResource TextTertiaryBrush}"
                                               FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                    <Border Grid.Column="1" Width="48" Height="36" CornerRadius="7" Background="#1C1F27"
                                            BorderBrush="#262A34" BorderThickness="1">
                                        <Grid>
                                            <TextBlock Text="{Binding Initials}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding HasLogo, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                            <Image Source="{Binding Logo}" Stretch="Uniform" Margin="4"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,6,0">
                                        <TextBlock x:Name="NameText" Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Grid Margin="0,3,0,0" Visibility="{Binding NowTitle, Converter={StaticResource NullToVis}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding NowTitle}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Grid x:Name="Track" Grid.Row="1" Height="2" Margin="0,5,0,0" Background="#262A34">
                                                <Border HorizontalAlignment="Left" Background="#7A8292">
                                                    <Border.Width>
                                                        <MultiBinding Converter="{StaticResource ProgressWidth}">
                                                            <Binding Path="NowProgress" />
                                                            <Binding ElementName="Track" Path="ActualWidth" />
                                                        </MultiBinding>
                                                    </Border.Width>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>

                                    <Button x:Name="StarBtn" Grid.Column="3" Style="{StaticResource StarButton}" Content="&#xE734;"
                                            Visibility="Hidden" ToolTip="Preferito (P)"
                                            Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="StarBtn" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                        <Setter TargetName="StarBtn" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="StarBtn" Property="Content" Value="&#xE735;" />
                                        <Setter TargetName="StarBtn" Property="Foreground" Value="{StaticResource StarBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter TargetName="NumText" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        <Setter TargetName="NameText" Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Lista film -->
                    <ListBox x:Name="MovieList" ContextMenuOpening="Library_ContextMenuOpening" ContextMenu="{StaticResource EmptyMenu}" Grid.Row="3" ItemsSource="{Binding VisibleMovies}"
                             Visibility="{Binding ShowMovieList, Converter={StaticResource BoolToVis}}"
                             Style="{StaticResource LibraryList}"
                             PreviewMouseLeftButtonUp="ChannelList_PreviewMouseLeftButtonUp" KeyDown="ChannelList_KeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:Movie}">
                                <Grid Height="80" Margin="8,0,8,0" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="46" Height="66" CornerRadius="6" Background="#1C1F27" BorderBrush="#262A34" BorderThickness="1">
                                        <Grid>
                                            <TextBlock Text="{Binding Initials}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding HasArt, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                            <Image Source="{Binding Art}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.Clip>
                                                    <RectangleGeometry Rect="0,0,44,64" RadiusX="5" RadiusY="5" />
                                                </Image.Clip>
                                            </Image>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="38" />
                                        <TextBlock Text="{Binding Meta}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"
                                                   Visibility="{Binding Meta, Converter={StaticResource NullToVis}}" />
                                        <Border Background="{StaticResource SurfacePressedBrush}" CornerRadius="4" Padding="6,1" Margin="0,6,0,0"
                                                HorizontalAlignment="Left" Visibility="{Binding HasVariants, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding VariantsText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Border>
                                        <Grid x:Name="Track" Height="3" Width="120" HorizontalAlignment="Left" Margin="0,7,0,0" Background="#262A34"
                                              Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}">
                                            <Border HorizontalAlignment="Left" Background="{StaticResource BrandBrush}">
                                                <Border.Width>
                                                    <MultiBinding Converter="{StaticResource ProgressWidth}">
                                                        <Binding Path="Progress" />
                                                        <Binding ElementName="Track" Path="ActualWidth" />
                                                    </MultiBinding>
                                                </Border.Width>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Lista serie -->
                    <ListBox x:Name="SeriesList" ContextMenuOpening="Library_ContextMenuOpening" ContextMenu="{StaticResource EmptyMenu}" Grid.Row="3" ItemsSource="{Binding VisibleSeries}"
                             Visibility="{Binding ShowSeriesList, Converter={StaticResource BoolToVis}}"
                             Style="{StaticResource LibraryList}"
                             PreviewMouseLeftButtonUp="ChannelList_PreviewMouseLeftButtonUp" KeyDown="ChannelList_KeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:Series}">
                                <Grid Height="80" Margin="8,0,8,0" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="46" Height="66" CornerRadius="6" Background="#1C1F27" BorderBrush="#262A34" BorderThickness="1">
                                        <Grid>
                                            <TextBlock Text="{Binding Initials}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding HasArt, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                            <Image Source="{Binding Art}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.Clip>
                                                    <RectangleGeometry Rect="0,0,44,64" RadiusX="5" RadiusY="5" />
                                                </Image.Clip>
                                            </Image>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,6,0">
                                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="38" />
                                        <TextBlock Text="{Binding Meta}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Meta, Converter={StaticResource NullToVis}}" />
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="4" Padding="6,1" Margin="0,6,6,0"
                                                    HorizontalAlignment="Left" Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="In corso" FontSize="10.5" FontWeight="SemiBold" Foreground="#9DBBFF" />
                                            </Border>
                                            <Border Background="{StaticResource SurfacePressedBrush}" CornerRadius="4" Padding="6,1" Margin="0,6,0,0"
                                                    HorizontalAlignment="Left" Visibility="{Binding HasVariants, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding VariantsText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="11"
                                               Foreground="{StaticResource TextTertiaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Vista a griglia: righe virtualizzate di riquadri -->
                    <ListBox x:Name="GridList" ContextMenuOpening="Library_ContextMenuOpening" ContextMenu="{StaticResource EmptyMenu}" Grid.Row="3" ItemsSource="{Binding GridRows}" Style="{StaticResource LibraryList}"
                             Visibility="{Binding ShowGridList, Converter={StaticResource BoolToVis}}" Padding="6,2,6,8"
                             PreviewMouseLeftButtonUp="GridList_PreviewMouseLeftButtonUp" GotKeyboardFocus="GridList_GotKeyboardFocus">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:GridRow}">
                                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" Columns="{Binding Columns}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.Resources>
                                        <Style x:Key="Tile" TargetType="Border">
                                            <Setter Property="Tag" Value="tile" />
                                            <Setter Property="Margin" Value="3" />
                                            <Setter Property="CornerRadius" Value="10" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="2" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsGridSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="White" />
                                                    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                        <DataTemplate DataType="{x:Type m:Channel}">
                                            <Border Style="{StaticResource Tile}" Height="96">
                                                <Grid Margin="6">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Border Background="#1C1F27" CornerRadius="8">
                                                        <Grid>
                                                            <TextBlock Text="{Binding Initials}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Visibility="{Binding HasLogo, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                                            <Image Source="{Binding Logo}" Stretch="Uniform" Margin="6" RenderOptions.BitmapScalingMode="HighQuality" />
                                                            <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{StaticResource StarBrush}"
                                                                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,5,0"
                                                                       Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}" />
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" Margin="2,5,2,0"
                                                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type m:ArtworkItem}">
                                            <Border Style="{StaticResource Tile}">
                                                <StackPanel Margin="5">
                                                    <Grid Height="146">
                                                        <Border Background="#1C1F27" CornerRadius="7" ClipToBounds="True">
                                                            <Grid>
                                                                <TextBlock Text="{Binding Initials}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Visibility="{Binding HasArt, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                                                <Image Source="{Binding Art}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                                            </Grid>
                                                        </Border>
                                                        <Border Background="#D0111318" CornerRadius="4" Padding="5,1" Margin="5" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                Visibility="{Binding HasVariants, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding VariantsText}" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                                                        </Border>
                                                        <Grid x:Name="Track" Height="3" VerticalAlignment="Bottom" Margin="6,0,6,6" Background="#80262A34"
                                                              Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}">
                                                            <Border HorizontalAlignment="Left" Background="{StaticResource BrandBrush}">
                                                                <Border.Width>
                                                                    <MultiBinding Converter="{StaticResource ProgressWidth}">
                                                                        <Binding Path="Progress" />
                                                                        <Binding ElementName="Track" Path="ActualWidth" />
                                                                    </MultiBinding>
                                                                </Border.Width>
                                                            </Border>
                                                        </Grid>
                                                    </Grid>
                                                    <TextBlock Text="{Binding ItemName}" FontSize="11.5" FontWeight="SemiBold" Margin="1,5,1,0"
                                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Height="30" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.Resources>
                                </ItemsControl>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Caricamento catalogo -->
                    <StackPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsLibraryLoading, Converter={StaticResource BoolToVis}}">
                        <ContentControl Style="{StaticResource Spinner}" />
                        <TextBlock Text="Caricamento catalogo…" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,14,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Dettaglio serie -->
                    <Grid Grid.Row="1" Grid.RowSpan="3" Background="{StaticResource PanelBrush}"
                          Visibility="{Binding OpenSeries, Converter={StaticResource NullToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="8,0,14,8">
                            <Button Style="{StaticResource IconButton}" Content="&#xE72B;" FontSize="13" HorizontalAlignment="Left"
                                    Command="{Binding CloseSeriesCommand}" ToolTip="Torna alle serie (Esc)" />
                            <TextBlock Text="{Binding OpenSeries.Name}" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold"
                                       Margin="42,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="14,0,14,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="76" Height="110" CornerRadius="8" Background="#1C1F27" BorderBrush="#262A34" BorderThickness="1"
                                    VerticalAlignment="Top">
                                <Grid>
                                    <TextBlock Text="{Binding OpenSeries.Initials}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding OpenSeries.HasArt, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                    <Image Source="{Binding OpenSeries.Art}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Clip>
                                            <RectangleGeometry Rect="0,0,74,108" RadiusX="7" RadiusY="7" />
                                        </Image.Clip>
                                    </Image>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="{Binding OpenSeriesMeta}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding OpenSeriesPlot}" FontSize="12" Foreground="#C2C8D2" TextWrapping="Wrap" Margin="0,6,0,0"
                                           MaxHeight="86" TextTrimming="WordEllipsis" ToolTip="{Binding OpenSeriesPlot}" />
                                <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Height="30" FontSize="12" Padding="10,0"
                                        Command="{Binding DownloadSeasonCommand}" ToolTip="Scarica tutti gli episodi della stagione per guardarli offline"
                                        Visibility="{Binding SelectedSeason, Converter={StaticResource NullToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text="Scarica la stagione" Margin="7,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <ListBox x:Name="SeasonList" Grid.Row="2" ItemsSource="{Binding Seasons}" SelectedItem="{Binding SelectedSeason}"
                                 ItemContainerStyle="{StaticResource ChipItem}" Background="Transparent" BorderThickness="0"
                                 Padding="14,0,14,8" Focusable="False" PreviewMouseWheel="CategoryList_PreviewMouseWheel">
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ScrollViewer x:Name="ChipScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                                  Padding="{TemplateBinding Padding}" Focusable="False">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:SeasonItem}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Count}" FontSize="11" Margin="7,0,0,0" Opacity="0.55" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ListBox x:Name="EpisodeList" ContextMenuOpening="Library_ContextMenuOpening" ContextMenu="{StaticResource EmptyMenu}" Grid.Row="3" ItemsSource="{Binding VisibleEpisodes}" Style="{StaticResource LibraryList}"
                                 PreviewMouseLeftButtonUp="ChannelList_PreviewMouseLeftButtonUp" KeyDown="ChannelList_KeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:Episode}">
                                    <Grid Height="62" Margin="6,0,10,0" Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="Num" Text="{Binding Number}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,6,0">
                                            <TextBlock Text="{Binding DisplayTitle}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding DurationText}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <Grid x:Name="Track" Height="3" Width="90" Margin="10,1,0,0" VerticalAlignment="Center" Background="#262A34"
                                                      Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}">
                                                    <Border HorizontalAlignment="Left" Background="{StaticResource BrandBrush}">
                                                        <Border.Width>
                                                            <MultiBinding Converter="{StaticResource ProgressWidth}">
                                                                <Binding Path="Progress" />
                                                                <Binding ElementName="Track" Path="ActualWidth" />
                                                            </MultiBinding>
                                                        </Border.Width>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12"
                                                   Foreground="#3DDC97" ToolTip="Visto"
                                                   Visibility="{Binding IsWatched, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter TargetName="Num" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding IsSeriesLoading, Converter={StaticResource BoolToVis}}">
                            <ContentControl Style="{StaticResource Spinner}" />
                            <TextBlock Text="Caricamento episodi…" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,14,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Row="3" Text="{Binding SeriesError}" Foreground="{StaticResource TextSecondaryBrush}" Margin="30,0"
                                   TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding SeriesError, Converter={StaticResource NullToVis}}" />
                    </Grid>

                    <!-- Scelta della versione (titolo pubblicato più volte) -->
                    <Grid Grid.Row="0" Grid.RowSpan="5" Background="{StaticResource PanelBrush}" Panel.ZIndex="10"
                          Visibility="{Binding ShowVariantPanel, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="8,8,14,8">
                            <Button Style="{StaticResource IconButton}" Content="&#xE72B;" FontSize="13" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Command="{Binding CloseVariantsCommand}" ToolTip="Annulla (Esc)" />
                            <StackPanel Margin="44,4,0,0">
                                <TextBlock Text="Scegli la versione" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding VariantOwner.ItemName}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5"
                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                        <ListBox x:Name="VariantPanelList" Grid.Row="1" ItemsSource="{Binding VariantChoices}" Style="{StaticResource LibraryList}"
                                 ItemTemplate="{StaticResource VariantItemTemplate}"
                                 PreviewMouseLeftButtonUp="VariantList_PreviewMouseLeftButtonUp" />
                        <TextBlock Grid.Row="2" Text="Invio per guardare  ·  Esc per annullare" Foreground="{StaticResource TextTertiaryBrush}"
                                   FontSize="12" Margin="16,8,16,12" />
                    </Grid>

                    <!-- Cosa guardo? Domande a risposta multipla e consigli -->
                    <Grid Grid.Row="0" Grid.RowSpan="5" Background="{StaticResource PanelBrush}" Panel.ZIndex="9"
                          Visibility="{Binding IsQuizOpen, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="8,8,14,8">
                            <Button Style="{StaticResource IconButton}" Content="&#xE72B;" FontSize="13" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Command="{Binding CloseQuizCommand}" ToolTip="Chiudi (Esc)" />
                            <StackPanel Margin="44,4,0,0">
                                <TextBlock Text="Cosa guardo?" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding QuizStep}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Domanda -->
                        <ScrollViewer x:Name="QuizQuestionView" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding IsQuizAsking, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="16,6,16,16">
                                <TextBlock Text="{Binding QuizQuestion.Text}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,14" />
                                <ItemsControl ItemsSource="{Binding QuizQuestion.Options}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SecondaryButton}" Height="42" Margin="0,0,0,8" HorizontalContentAlignment="Left"
                                                    Padding="16,0" Content="{Binding Label}"
                                                    Command="{Binding DataContext.AnswerQuizCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Consigli -->
                        <Grid Grid.Row="1" Visibility="{Binding IsQuizDone, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding QuizNote}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" TextWrapping="Wrap"
                                       Margin="16,0,16,8" Visibility="{Binding QuizNote, Converter={StaticResource NullToVis}}" />
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding IsQuizLoading, Converter={StaticResource BoolToVis}}">
                                <ContentControl Style="{StaticResource Spinner}" />
                                <TextBlock Text="Cerco qualcosa per te…" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,14,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                            <ScrollViewer x:Name="QuizResultsView" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding QuizResults}" Margin="8,0,8,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SecondaryButton}" Height="Auto" Margin="0,0,0,8" Padding="8"
                                                    HorizontalContentAlignment="Stretch"
                                                    Command="{Binding DataContext.QuizOpenResultCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="46" Height="68" CornerRadius="7" Background="#1C1F27" ClipToBounds="True">
                                                        <Grid>
                                                            <TextBlock Text="{Binding Initials}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <Image Source="{Binding Item.Art}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="40" />
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <UniformGrid Grid.Row="2" Columns="2" Margin="16,8,16,14">
                                <Button Style="{StaticResource PrimaryButton}" Height="38" Margin="0,0,6,0" Content="Altri consigli"
                                        Command="{Binding QuizMoreCommand}" />
                                <Button Style="{StaticResource SecondaryButton}" Height="38" Margin="6,0,0,0" Content="Ricomincia"
                                        Command="{Binding QuizRestartCommand}" />
                            </UniformGrid>
                        </Grid>
                    </Grid>

                    <!-- Stati vuoti / caricamento -->
                    <StackPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <ContentControl Style="{StaticResource Spinner}" />
                        <TextBlock Text="{Binding BusyText}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,14,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="EmptyState" Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30,0"
                                Visibility="Collapsed">
                        <TextBlock x:Name="EmptyGlyph" Text="&#xE721;" Style="{StaticResource Icon}" FontSize="28"
                                   Foreground="{StaticResource TextTertiaryBrush}" />
                        <TextBlock x:Name="EmptyText" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0"
                                   TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Piè di pagina -->
                    <Border Grid.Row="4" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="16,0,8,0" Height="40">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Foreground="{StaticResource TextTertiaryBrush}" FontSize="11.5">
                                    <Run Text="{Binding ItemCountText, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text=" · " Foreground="{StaticResource TextTertiaryBrush}" FontSize="11.5"
                                           Visibility="{Binding FooterInfo, Converter={StaticResource NullToVis}}" />
                                <TextBlock Text="{Binding FooterInfo}" Foreground="{StaticResource TextTertiaryBrush}" FontSize="11.5" />
                            </StackPanel>
                            <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="12.5"
                                    HorizontalAlignment="Right" Command="{Binding RefreshCommand}" ToolTip="Aggiorna elenco (Ctrl+R)"
                                    RenderTransformOrigin="0.5,0.5">
                                <TextBlock x:Name="RefreshGlyph" Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12.5"
                                           RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform x:Name="RefreshRotate" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- ==== Impostazioni (sopra la lista) ==== -->
                    <Border Grid.RowSpan="5" Background="{StaticResource PanelBrush}"
                            Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="18,10,10,4">
                                <TextBlock Text="Impostazioni" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="11" HorizontalAlignment="Right"
                                        Command="{Binding ToggleSettingsCommand}" ToolTip="Chiudi (Esc)" />
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,0,18,18">
                                <StackPanel>
                                    <TextBlock Text="ACCOUNT" Style="{StaticResource SectionTitle}" Margin="2,10,0,10" />
                                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="14,12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding LoginUsername}" FontWeight="SemiBold" FontSize="13.5" />
                                            <TextBlock Text="{Binding LoginServer}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                        Visibility="{Binding AccountInfo, Converter={StaticResource NullToVis}}">
                                                <Ellipse Width="7" Height="7" Fill="#3DDC97" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding AccountInfo}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                                           Margin="7,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="RIPRODUZIONE" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Formato del flusso" Style="{StaticResource FieldLabel}" />
                                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="9" Padding="2">
                                        <UniformGrid Columns="2">
                                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="fmt" Content="MPEG-TS (consigliato)"
                                                         IsChecked="{Binding UseHls, Converter={StaticResource InvertBool}}" />
                                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="fmt" Content="HLS"
                                                         IsChecked="{Binding UseHls}" />
                                        </UniformGrid>
                                    </Border>

                                    <TextBlock Text="Buffer di rete" Style="{StaticResource FieldLabel}" Margin="2,16,0,7" />
                                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="9" Padding="2">
                                        <UniformGrid Columns="4">
                                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="buf" Content="Basso"
                                                         ToolTip="0,8 s · cambio canale più rapido"
                                                         IsChecked="{Binding NetworkCachingMs, Converter={StaticResource IntEquals}, ConverterParameter=800}" />
                                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="buf" Content="Normale"
                                                         ToolTip="1,5 s · bilanciato"
                                                         IsChecked="{Binding NetworkCachingMs, Converter={StaticResource IntEquals}, ConverterParameter=1500}" />
                                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="buf" Content="Alto"
                                                         ToolTip="3 s · per connessioni instabili"
                                                         IsChecked="{Binding NetworkCachingMs, Converter={StaticResource IntEquals}, ConverterParameter=3000}" />
                                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="buf" Content="Max"
                                                         ToolTip="6 s · massima stabilità"
                                                         IsChecked="{Binding NetworkCachingMs, Converter={StaticResource IntEquals}, ConverterParameter=6000}" />
                                        </UniformGrid>
                                    </Border>
                                    <TextBlock Text="Se l'immagine si blocca spesso, aumenta il buffer." Foreground="{StaticResource TextTertiaryBrush}"
                                               FontSize="11.5" Margin="2,7,0,6" TextWrapping="Wrap" />

                                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HardwareDecoding}">
                                        <StackPanel>
                                            <TextBlock Text="Decodifica hardware" />
                                            <TextBlock Text="Usa la scheda video: meno CPU, più fluido" Foreground="{StaticResource TextTertiaryBrush}" FontSize="11.5" />
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Deinterlace}" Margin="0,6,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Deinterlacciamento automatico" />
                                            <TextBlock Text="Elimina le righe sui canali del digitale terrestre" Foreground="{StaticResource TextTertiaryBrush}" FontSize="11.5" />
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoPlayLastChannel}" Margin="0,6,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Riprendi l'ultimo canale all'avvio" />
                                            <TextBlock Text="Apri il programma e sei già sul canale" Foreground="{StaticResource TextTertiaryBrush}" FontSize="11.5" />
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HideAdult}" Margin="0,6,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Nascondi XXX" />
                                            <TextBlock Text="Toglie canali, film e serie delle categorie con XXX nel nome" Foreground="{StaticResource TextTertiaryBrush}" FontSize="11.5"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </CheckBox>

                                    <TextBlock Text="MODALITÀ TV" Style="{StaticResource SectionTitle}" />
                                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="14,12">
                                        <StackPanel>
                                            <TextBlock Text="Interfaccia a schermo intero con riquadri grandi, da usare col divano: controller, telecomando per PC o solo frecce, Invio ed Esc."
                                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                            <Button Style="{StaticResource PrimaryButton}" Height="38" FontSize="13" Margin="0,12,0,4" Click="EnterTv_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,10,0" />
                                                    <TextBlock Text="Attiva modalità TV   (Ctrl+T)" />
                                                </StackPanel>
                                            </Button>
                                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartInTvMode}" Margin="0,6,0,0">
                                                <TextBlock Text="Avvia direttamente in modalità TV" />
                                            </CheckBox>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="SCORCIATOIE" Style="{StaticResource SectionTitle}" />
                                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="14,10">
                                        <Grid x:Name="ShortcutGrid" TextElement.FontSize="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="132" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="AGGIORNAMENTI" Style="{StaticResource SectionTitle}" />
                                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="14,12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding UpdateStatus}" FontSize="12.5" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding UpdateNotes}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                                       TextWrapping="Wrap" MaxHeight="120" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"
                                                       Visibility="{Binding UpdateNotes, Converter={StaticResource NullToVis}}" />

                                            <!-- Barra di avanzamento del download -->
                                            <Grid Margin="0,10,0,2" Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVis}}">
                                                <ProgressBar Height="4" Minimum="0" Maximum="1" Value="{Binding UpdateProgress, Mode=OneWay}"
                                                             Foreground="{StaticResource AccentBrush}" Background="#22FFFFFF" BorderThickness="0">
                                                    <ProgressBar.Template>
                                                        <ControlTemplate TargetType="ProgressBar">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="2">
                                                                <Grid>
                                                                    <Border x:Name="PART_Track" />
                                                                    <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                                                            CornerRadius="2" HorizontalAlignment="Left" />
                                                                </Grid>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </ProgressBar.Template>
                                                </ProgressBar>
                                            </Grid>

                                            <WrapPanel Margin="0,12,0,0">
                                                <Button Style="{StaticResource PrimaryButton}" Height="36" FontSize="13" Padding="16,0" Margin="0,0,8,6"
                                                        Content="{Binding UpdateButtonText}" Command="{Binding InstallUpdateCommand}"
                                                        Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}"
                                                        IsEnabled="{Binding IsDownloadingUpdate, Converter={StaticResource InvertBool}}" />
                                                <Button Style="{StaticResource SecondaryButton}" Content="Annulla" Margin="0,0,8,6"
                                                        Command="{Binding CancelUpdateCommand}"
                                                        Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVis}}" />
                                                <Button Style="{StaticResource SecondaryButton}" Content="Cerca aggiornamenti" Margin="0,0,8,6"
                                                        Command="{Binding CheckForUpdatesCommand}"
                                                        IsEnabled="{Binding IsCheckingUpdate, Converter={StaticResource InvertBool}}" />
                                            </WrapPanel>
                                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoCheckUpdates}" Margin="0,4,0,0">
                                                <TextBlock Text="Controlla gli aggiornamenti all'avvio" />
                                            </CheckBox>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="DATI" Style="{StaticResource SectionTitle}" />
                                    <WrapPanel>
                                        <Button Style="{StaticResource SecondaryButton}" Content="Svuota cache" Command="{Binding ClearCacheCommand}" Margin="0,0,8,8" />
                                        <Button Style="{StaticResource DangerButton}" Content="Esci dall'account" Command="{Binding LogoutCommand}" Margin="0,0,8,8" />
                                    </WrapPanel>

                                    <TextBlock Foreground="{StaticResource TextTertiaryBrush}" FontSize="11.5" Margin="2,14,0,0">
                                        <Run Text="IPTVISION" /><Run Text=" " /><Run Text="{Binding Version, Mode=OneWay}" /><Run Text=" · motore libVLC · " /><Hyperlink
                                            NavigateUri="{Binding RepositoryUrl, Mode=OneWay}" RequestNavigate="Hyperlink_RequestNavigate"
                                            Foreground="{StaticResource TextSecondaryBrush}">GitHub</Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- ==== Download (sopra la lista) ==== -->
                    <Border Grid.RowSpan="5" Background="{StaticResource PanelBrush}"
                            Visibility="{Binding IsDownloadsOpen, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="18,10,10,4">
                                <TextBlock Text="Download" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource IconButton}" Content="&#xE838;" FontSize="13"
                                            Command="{Binding OpenDownloadsFolderCommand}" ToolTip="Apri la cartella dei download" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="11"
                                            Command="{Binding ToggleDownloadsCommand}" ToolTip="Chiudi (Esc)" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding DownloadsSummary}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                       Margin="20,0,18,10" TextWrapping="Wrap" />

                            <ListBox x:Name="DownloadList" Grid.Row="2" ItemsSource="{Binding DownloadService.Items}" Style="{StaticResource LibraryList}"
                                     PreviewMouseLeftButtonUp="ChannelList_PreviewMouseLeftButtonUp" KeyDown="ChannelList_KeyDown">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type svc:DownloadItem}">
                                        <Grid Margin="8,8,4,8" Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="Glyph" Text="&#xE8B2;" Style="{StaticResource Icon}" FontSize="17"
                                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,6,0">
                                                <TextBlock Text="{Binding DisplayTitle}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                                           Margin="0,2,0,0" Visibility="{Binding Subtitle, Converter={StaticResource NullToVis}}" />
                                                <Grid x:Name="Track" Height="3" Margin="0,6,0,0" Background="#262A34"
                                                      Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                                    <Border HorizontalAlignment="Left" Background="{StaticResource BrandBrush}">
                                                        <Border.Width>
                                                            <MultiBinding Converter="{StaticResource ProgressWidth}">
                                                                <Binding Path="Progress" />
                                                                <Binding ElementName="Track" Path="ActualWidth" />
                                                            </MultiBinding>
                                                        </Border.Width>
                                                    </Border>
                                                </Grid>
                                                <TextBlock x:Name="Status" Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE74D;" FontSize="12" VerticalAlignment="Center"
                                                    ToolTip="Elimina o annulla" Command="{Binding DataContext.DeleteDownloadCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                <Setter TargetName="Glyph" Property="Text" Value="&#xE768;" />
                                                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter TargetName="Glyph" Property="Text" Value="&#xE896;" />
                                                <Setter TargetName="Glyph" Property="Foreground" Value="#3DDC97" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                <Setter TargetName="Glyph" Property="Text" Value="&#xE783;" />
                                                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                <Setter TargetName="Status" Property="Foreground" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Grid.Row="2" Margin="30,0" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Visibility="{Binding HasDownloads, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                       Text="Nessun download. Clic destro su un film, una serie o un episodio (oppure tasto D) e scegli Scarica: potrai guardarlo anche senza connessione." />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ==== Video ==== -->
            <Grid x:Name="VideoHost" Grid.Column="1" Background="Black" Visibility="{Binding ShowVideo, Converter={StaticResource BoolToVis}}">
                <local:VideoSurface x:Name="Video" />
                <!-- Il contenuto viene spostato in una finestra trasparente sopra il video (vedi MainWindow.xaml.cs) -->
                <Border x:Name="OverlayHolder" Visibility="Collapsed">
                    <Grid x:Name="OverlayRoot" Background="#01000000"
                          MouseMove="Overlay_MouseMove" MouseLeftButtonDown="Overlay_MouseLeftButtonDown"
                          MouseWheel="Overlay_MouseWheel" MouseLeave="Overlay_MouseLeave" PreviewKeyDown="Overlay_PreviewKeyDown">

                        <!-- Copertura durante il cambio canale -->
                        <Border Background="Black" IsHitTestVisible="False"
                                Visibility="{Binding IsVideoCovered, Converter={StaticResource BoolToVis}}" />

                        <!-- Nessun canale -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"
                                    Visibility="{Binding ShowIdlePlaceholder, Converter={StaticResource BoolToVis}}">
                            <Image Source="pack://application:,,,/Assets/logo.png" Width="64" Height="64" Opacity="0.9"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="Nessun contenuto in riproduzione" Foreground="White" FontSize="17" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,18,0,4" FontFamily="{StaticResource DisplayFont}"
                                       Visibility="{Binding PlaybackError, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                            <TextBlock Text="{Binding PlaybackError}" Foreground="#FFB3BA" FontSize="14" TextAlignment="Center"
                                       HorizontalAlignment="Center" Margin="0,18,0,0" TextWrapping="Wrap" MaxWidth="460"
                                       Visibility="{Binding PlaybackError, Converter={StaticResource NullToVis}}" />
                            <TextBlock Text="Scegli un canale, un film o una serie dall'elenco"
                                       Visibility="{Binding PlaybackError, Converter={StaticResource NullToVis}, ConverterParameter=invert}" Foreground="#99FFFFFF" FontSize="13"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Caricamento / riconnessione -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"
                                    Visibility="{Binding IsPlaybackBusy, Converter={StaticResource BoolToVis}}">
                            <ContentControl Style="{StaticResource Spinner}" />
                            <Border Background="#99000000" CornerRadius="12" Padding="12,5" Margin="0,14,0,0" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding PlaybackMessage}" Foreground="#E6FFFFFF" FontSize="13" />
                            </Border>
                        </StackPanel>

                        <!-- Banner informazioni (canale / film / episodio) -->
                        <Border x:Name="InfoBanner" VerticalAlignment="Top" Background="{StaticResource TopShade}" Padding="28,22,28,70"
                                Opacity="0" IsHitTestVisible="False">
                            <Grid>
                                <!-- TV -->
                                <Grid Visibility="{Binding IsVod, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="84" Height="62" CornerRadius="12" Background="#CC15181F" BorderBrush="#33FFFFFF" BorderThickness="1"
                                            VerticalAlignment="Top">
                                        <Grid>
                                            <TextBlock Text="{Binding CurrentChannel.Initials}" FontSize="20" FontWeight="Bold" Foreground="#CCFFFFFF"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding CurrentChannel.HasLogo, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                            <Image Source="{Binding CurrentChannel.Logo}" Margin="8" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="18,0,0,0" MaxWidth="640" HorizontalAlignment="Left">
                                        <StackPanel.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.85" Color="Black" />
                                        </StackPanel.Effect>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{StaticResource BrandBrush}" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CurrentChannel.Num}" Foreground="White" FontWeight="Bold" FontSize="14" />
                                            </Border>
                                            <TextBlock Text="{Binding CurrentChannel.Name}" Foreground="White" FontSize="24" FontWeight="SemiBold"
                                                       FontFamily="{StaticResource DisplayFont}" Margin="12,0,0,0" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border Background="{StaticResource LiveBrush}" CornerRadius="4" Padding="6,1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="LIVE" Foreground="White" FontSize="10.5" FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Margin="0,10,0,0" Visibility="{Binding CurrentNow, Converter={StaticResource NullToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding CurrentNow.TimeRange}" Foreground="#B3FFFFFF" FontSize="13" Margin="0,0,10,0" />
                                                <TextBlock Text="{Binding CurrentNow.Title}" Foreground="White" FontSize="15" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="480" />
                                            </StackPanel>
                                            <Grid x:Name="BannerTrack" Width="320" Height="3" HorizontalAlignment="Left" Margin="0,8,0,0" Background="#40FFFFFF">
                                                <Border HorizontalAlignment="Left" Background="{StaticResource BrandBrush}" CornerRadius="1.5">
                                                    <Border.Width>
                                                        <MultiBinding Converter="{StaticResource ProgressWidth}">
                                                            <Binding Path="CurrentProgress" />
                                                            <Binding ElementName="BannerTrack" Path="ActualWidth" />
                                                        </MultiBinding>
                                                    </Border.Width>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding CurrentNow.Description}" Foreground="#B3FFFFFF" FontSize="12.5" Margin="0,8,0,0"
                                                       TextWrapping="Wrap" MaxHeight="36" TextTrimming="WordEllipsis"
                                                       Visibility="{Binding CurrentNow.Description, Converter={StaticResource NullToVis}}" />
                                        </StackPanel>
                                        <TextBlock Margin="0,8,0,0" Foreground="#99FFFFFF" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding CurrentNext, Converter={StaticResource NullToVis}}">
                                            <Run Text="Dopo" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding CurrentNext.TimeRange, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding CurrentNext.Title, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>

                                <!-- Film / episodio -->
                                <Grid Visibility="{Binding IsVod, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="78" Height="114" CornerRadius="10" Background="#CC15181F" BorderBrush="#33FFFFFF" BorderThickness="1"
                                            VerticalAlignment="Top">
                                        <Grid>
                                            <TextBlock Text="&#xE8B2;" Style="{StaticResource Icon}" FontSize="22" Foreground="#99FFFFFF"
                                                       Visibility="{Binding NowPlayingArtwork.HasArt, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                            <Image Source="{Binding NowPlayingArtwork.Art}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.Clip>
                                                    <RectangleGeometry Rect="0,0,76,112" RadiusX="9" RadiusY="9" />
                                                </Image.Clip>
                                            </Image>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="18,0,0,0" MaxWidth="680" HorizontalAlignment="Left">
                                        <StackPanel.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.85" Color="Black" />
                                        </StackPanel.Effect>
                                        <TextBlock Text="{Binding NowPlayingTitle}" Foreground="White" FontSize="24" FontWeight="SemiBold"
                                                   FontFamily="{StaticResource DisplayFont}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding NowPlayingSubtitle}" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding NowPlayingSubtitle, Converter={StaticResource NullToVis}}" />
                                        <TextBlock Text="{Binding NowPlayingMeta}" Foreground="#B3FFFFFF" FontSize="12.5" Margin="0,6,0,0"
                                                   Visibility="{Binding NowPlayingMeta, Converter={StaticResource NullToVis}}" />
                                        <TextBlock Text="{Binding NowPlayingPlot}" Foreground="#D9FFFFFF" FontSize="12.5" Margin="0,8,0,0"
                                                   TextWrapping="Wrap" MaxHeight="54" TextTrimming="WordEllipsis"
                                                   Visibility="{Binding NowPlayingPlot, Converter={StaticResource NullToVis}}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Numero digitato -->
                        <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,28,32,0" Background="#D9000000"
                                CornerRadius="14" Padding="22,6" IsHitTestVisible="False"
                                Visibility="{Binding NumberEntry, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="{Binding NumberEntry}" Foreground="White" FontSize="46" FontWeight="Bold"
                                       FontFamily="{StaticResource DisplayFont}" />
                        </Border>

                        <!-- In pausa -->
                        <Border VerticalAlignment="Center" HorizontalAlignment="Center" Width="76" Height="76" CornerRadius="38"
                                Background="#99000000" IsHitTestVisible="False"
                                Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="&#xE769;" Style="{StaticResource Icon}" FontSize="28" Foreground="White" />
                        </Border>

                        <!-- Notifica -->
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,140" Background="#EB1A1D24"
                                BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="20" Padding="16,8" IsHitTestVisible="False"
                                Visibility="{Binding Toast, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="{Binding Toast}" Foreground="White" FontSize="13" />
                        </Border>

                        <!-- Prossimo episodio -->
                        <Border x:Name="NextEpisodeCard" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,24,140" Width="320"
                                Background="#F0181B22" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="14" Padding="16,14"
                                Visibility="{Binding NextEpisodeOffer, Converter={StaticResource NullToVis}}">
                            <StackPanel>
                                <TextBlock Foreground="#99FFFFFF" FontSize="11.5" FontWeight="SemiBold">
                                    <Run Text="PROSSIMO EPISODIO TRA " /><Run Text="{Binding NextEpisodeCountdown, Mode=OneWay}" /><Run Text=" S" />
                                </TextBlock>
                                <TextBlock Text="{Binding NextEpisodeOffer.Label}" Foreground="White" FontSize="13" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding NextEpisodeOffer.DisplayTitle}" Foreground="White" FontSize="15" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,12" />
                                <UniformGrid Columns="2">
                                    <Button Style="{StaticResource PrimaryButton}" Height="36" FontSize="13" Margin="0,0,6,0"
                                            Command="{Binding PlayNextEpisodeNowCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                            <TextBlock Text="Guarda ora" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButton}" Content="Annulla" Margin="6,0,0,0"
                                            Command="{Binding CancelNextEpisodeCommand}" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Barra comandi -->
                        <Grid x:Name="ControlBar" VerticalAlignment="Bottom" Background="{StaticResource ControlBarShade}" Opacity="0">
                            <StackPanel VerticalAlignment="Bottom" Margin="18,60,18,16">
                                <!-- Avanzamento (film / episodi) -->
                                <Grid Margin="6,0,6,4" Visibility="{Binding IsVod, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding PositionText}" Foreground="White" FontSize="12" MinWidth="52" VerticalAlignment="Center" />
                                    <Slider x:Name="SeekSlider" Grid.Column="1" Style="{StaticResource SeekSlider}" Minimum="0" Maximum="1"
                                            Margin="8,0" VerticalAlignment="Center"
                                            Thumb.DragStarted="Seek_DragStarted" Thumb.DragCompleted="Seek_DragCompleted"
                                            ValueChanged="Seek_ValueChanged" />
                                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" Foreground="#B3FFFFFF" FontSize="12" MinWidth="52"
                                               TextAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Height="46">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal">
                                        <!-- TV -->
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsVod, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                            <Button Style="{StaticResource OverlayButton}" Content="&#xE892;" Command="{Binding PreviousChannelCommand}"
                                                    ToolTip="Canale precedente (↓)" />
                                        </StackPanel>
                                        <!-- Film / episodi -->
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsVod, Converter={StaticResource BoolToVis}}">
                                            <Button Style="{StaticResource OverlayButton}" Content="&#xE892;" Command="{Binding PreviousEpisodeCommand}"
                                                    ToolTip="Episodio precedente (PagGiù)"
                                                    Visibility="{Binding HasPreviousEpisode, Converter={StaticResource BoolToVis}}" />
                                            <Button Style="{StaticResource OverlayButton}" Content="&#xED3C;" Command="{Binding SkipBackCommand}"
                                                    ToolTip="Indietro 10 s (←)" />
                                        </StackPanel>

                                        <Button x:Name="PlayButton" Style="{StaticResource OverlayButton}" Width="46" Height="46"
                                                Command="{Binding TogglePlayCommand}" ToolTip="Riproduci/pausa (Spazio)">
                                            <TextBlock Text="{Binding PlayPauseGlyph}" Style="{StaticResource Icon}" FontSize="18" />
                                        </Button>

                                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsVod, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                            <Button Style="{StaticResource OverlayButton}" Content="&#xE893;" Command="{Binding NextChannelCommand}"
                                                    ToolTip="Canale successivo (↑)" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsVod, Converter={StaticResource BoolToVis}}">
                                            <Button Style="{StaticResource OverlayButton}" Content="&#xED3D;" Command="{Binding SkipForwardCommand}"
                                                    ToolTip="Avanti 30 s (→: 10 s)" />
                                            <Button Style="{StaticResource OverlayButton}" Content="&#xE71A;" FontSize="14" Command="{Binding StopVodCommand}"
                                                    ToolTip="Stop (S)" />
                                            <Button Style="{StaticResource OverlayButton}" Content="&#xE893;" Command="{Binding NextEpisodeCommand}"
                                                    ToolTip="Episodio successivo (PagSu)"
                                                    Visibility="{Binding HasNextEpisode, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <Button Style="{StaticResource OverlayButton}" Content="&#xE72C;" FontSize="14" Command="{Binding ReloadCommand}"
                                                ToolTip="Ricarica (R)" Margin="4,0,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0">
                                        <TextBlock Text="{Binding NowPlayingTitle}" Foreground="White" FontSize="14" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding NowPlayingSubtitle}" Foreground="#A6FFFFFF" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding NowPlayingSubtitle, Converter={StaticResource NullToVis}}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button x:Name="FavButton" Style="{StaticResource OverlayButton}" FontSize="15"
                                                Command="{Binding ToggleFavoriteCommand}" ToolTip="Preferito (P)"
                                                Visibility="{Binding IsVod, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                            <TextBlock FontSize="15">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                        <Setter Property="Text" Value="&#xE734;" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CurrentChannel.IsFavorite}" Value="True">
                                                                <Setter Property="Text" Value="&#xE735;" />
                                                                <Setter Property="Foreground" Value="{StaticResource StarBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                        <Button x:Name="TracksButton" Style="{StaticResource OverlayButton}" Content="&#xE8D6;" FontSize="15"
                                                Click="TracksButton_Click" ToolTip="Audio, sottotitoli e formato immagine" />
                                        <Button Style="{StaticResource OverlayButton}" Command="{Binding ToggleMuteCommand}" ToolTip="Muto (M)" Margin="6,0,0,0">
                                            <TextBlock Style="{StaticResource Icon}" FontSize="16">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource VolumeGlyph}">
                                                        <Binding Path="Volume" />
                                                        <Binding Path="IsMuted" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Button>
                                        <Slider Style="{StaticResource VolumeSlider}" Width="96" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                                Value="{Binding Volume}" Margin="2,0,6,0" SmallChange="5" LargeChange="10" />
                                        <TextBlock Text="{Binding Volume}" Foreground="#B3FFFFFF" FontSize="11.5" Width="26" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource OverlayButton}" Content="&#xE8A0;" FontSize="15" Click="TogglePanel_Click"
                                                ToolTip="Mostra/nascondi elenco (L)" Margin="4,0,0,0" />
                                        <Button x:Name="FullscreenButton" Style="{StaticResource OverlayButton}" Click="Fullscreen_Click"
                                                ToolTip="Schermo intero (F)">
                                            <TextBlock x:Name="FullscreenGlyph" Style="{StaticResource Icon}" FontSize="15" Text="&#xE740;" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ======================= Modalità TV (stile Big Picture) ======================= -->
        <Grid x:Name="TvLayer" Grid.RowSpan="2" Visibility="{Binding ShowTvLayer, Converter={StaticResource BoolToVis}}"
              TextElement.Foreground="White" Cursor="None">
            <Grid.Background>
                <RadialGradientBrush Center="0.2,0" GradientOrigin="0.2,0" RadiusX="1.1" RadiusY="1.2">
                    <GradientStop Color="#1B2A52" Offset="0" />
                    <GradientStop Color="#0C0E14" Offset="0.55" />
                    <GradientStop Color="#08090D" Offset="1" />
                </RadialGradientBrush>
            </Grid.Background>
            <Grid.Resources>
                <!-- Riquadro con evidenza quando selezionato -->
                <Style x:Key="TvCard" TargetType="Border">
                    <Setter Property="Background" Value="#161921" />
                    <Setter Property="BorderBrush" Value="#00FFFFFF" />
                    <Setter Property="BorderThickness" Value="3" />
                    <Setter Property="CornerRadius" Value="16" />
                    <Setter Property="Margin" Value="12" />
                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsTvFocused}" Value="True">
                            <Setter Property="BorderBrush" Value="White" />
                            <Setter Property="Background" Value="#252A36" />
                            <Setter Property="Panel.ZIndex" Value="10" />
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="34" ShadowDepth="0" Opacity="0.75" Color="#3D7BFF" />
                                </Setter.Value>
                            </Setter>
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.06" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.06" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>

                <Style x:Key="TvWideCard" TargetType="Border">
                    <Setter Property="Background" Value="#161921" />
                    <Setter Property="BorderBrush" Value="#00FFFFFF" />
                    <Setter Property="BorderThickness" Value="3" />
                    <Setter Property="CornerRadius" Value="16" />
                    <Setter Property="Margin" Value="12" />
                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsTvFocused}" Value="True">
                            <Setter Property="BorderBrush" Value="White" />
                            <Setter Property="Background" Value="#252A36" />
                            <Setter Property="Panel.ZIndex" Value="10" />
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="34" ShadowDepth="0" Opacity="0.75" Color="#3D7BFF" />
                                </Setter.Value>
                            </Setter>
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.015" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.015" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>

                <Style x:Key="TvPill" TargetType="Border">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="CornerRadius" Value="28" />
                    <Setter Property="Padding" Value="24,11" />
                    <Setter Property="Margin" Value="0,0,10,0" />
                    <Setter Property="TextElement.Foreground" Value="#8F98A8" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="Background" Value="#262B36" />
                            <Setter Property="TextElement.Foreground" Value="White" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsTvFocused}" Value="True">
                            <Setter Property="Background" Value="White" />
                            <Setter Property="TextElement.Foreground" Value="#0A0B0F" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>

                <DataTemplate DataType="{x:Type m:CategoryItem}">
                    <Border Style="{StaticResource TvCard}" Height="150">
                        <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                        <Grid Margin="24,20">
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="26" HorizontalAlignment="Left"
                                       VerticalAlignment="Top" Foreground="#8FB1FF" />
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           FontFamily="{StaticResource DisplayFont}" />
                                <TextBlock Text="{Binding Count}" FontSize="15" Foreground="#99A3B5" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>

                <DataTemplate DataType="{x:Type m:Channel}">
                    <Border Style="{StaticResource TvCard}" Height="210">
                        <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                        <Grid Margin="20,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="{Binding Initials}" FontSize="34" FontWeight="Bold" Foreground="#99A3B5"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding HasLogo, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                <Image Source="{Binding Logo}" Stretch="Uniform" MaxHeight="86" RenderOptions.BitmapScalingMode="HighQuality" />
                                <Border Background="#33FFFFFF" CornerRadius="8" Padding="9,2" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Num}" FontSize="15" FontWeight="Bold" />
                                </Border>
                            </Grid>
                            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding NowTitle}" FontSize="14" Foreground="#99A3B5" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                                           Visibility="{Binding NowTitle, Converter={StaticResource NullToVis}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>

                <DataTemplate DataType="{x:Type m:Movie}">
                    <Border Style="{StaticResource TvCard}" Height="420" ClipToBounds="True">
                        <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Background="#1E222C" CornerRadius="13,13,0,0" ClipToBounds="True">
                                <Grid>
                                    <TextBlock Text="{Binding Initials}" FontSize="40" FontWeight="Bold" Foreground="#66FFFFFF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding HasArt, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                    <Image Source="{Binding Art}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Border Background="#D0111318" CornerRadius="6" Padding="9,3" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Visibility="{Binding HasVariants, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding VariantsText}" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                                    </Border>
                                    <Grid x:Name="Track" Height="5" VerticalAlignment="Bottom" Background="#80000000"
                                          Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}">
                                        <Border HorizontalAlignment="Left" Background="{StaticResource BrandBrush}">
                                            <Border.Width>
                                                <MultiBinding Converter="{StaticResource ProgressWidth}">
                                                    <Binding Path="Progress" />
                                                    <Binding ElementName="Track" Path="ActualWidth" />
                                                </MultiBinding>
                                            </Border.Width>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Row="1" Margin="14,10,14,14">
                                <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Meta}" FontSize="13.5" Foreground="#99A3B5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>

                <DataTemplate DataType="{x:Type m:Series}">
                    <Border Style="{StaticResource TvCard}" Height="420" ClipToBounds="True">
                        <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Background="#1E222C" CornerRadius="13,13,0,0" ClipToBounds="True">
                                <Grid>
                                    <TextBlock Text="{Binding Initials}" FontSize="40" FontWeight="Bold" Foreground="#66FFFFFF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding HasArt, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                    <Image Source="{Binding Art}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Border Background="#D0111318" CornerRadius="6" Padding="9,3" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Visibility="{Binding HasVariants, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding VariantsText}" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                                    </Border>
                                    <Border Background="{StaticResource AccentBrush}" CornerRadius="6" Padding="8,3" Margin="10"
                                            HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                            Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="In corso" FontSize="12.5" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Row="1" Margin="14,10,14,14">
                                <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Meta}" FontSize="13.5" Foreground="#99A3B5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>

                <DataTemplate DataType="{x:Type m:Episode}">
                    <Border Style="{StaticResource TvWideCard}" Height="104" Margin="12,6">
                        <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                        <Grid Margin="24,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Num" Text="{Binding Number}" FontSize="30" FontWeight="SemiBold" Foreground="#7F889A"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayTitle}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding DurationText}" FontSize="15" Foreground="#99A3B5" />
                                    <Grid x:Name="Track" Width="180" Height="4" Margin="14,1,0,0" VerticalAlignment="Center" Background="#33FFFFFF"
                                          Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}">
                                        <Border HorizontalAlignment="Left" Background="{StaticResource BrandBrush}">
                                            <Border.Width>
                                                <MultiBinding Converter="{StaticResource ProgressWidth}">
                                                    <Binding Path="Progress" />
                                                    <Binding ElementName="Track" Path="ActualWidth" />
                                                </MultiBinding>
                                            </Border.Width>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="22" Foreground="#3DDC97"
                                       Visibility="{Binding IsWatched, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                            <Setter TargetName="Num" Property="Foreground" Value="#8FB1FF" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>

                <DataTemplate DataType="{x:Type m:SearchHit}">
                    <Border Style="{StaticResource TvWideCard}" Height="112" Margin="12,6">
                        <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                        <Grid Margin="18,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Thumb" Width="128" Height="76" CornerRadius="10" Background="#1E222C" ClipToBounds="True">
                                <Grid>
                                    <TextBlock Text="{Binding Initials}" FontSize="22" FontWeight="Bold" Foreground="#66FFFFFF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Source="{Binding Item.Logo}" Stretch="Uniform" Margin="10" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Image Source="{Binding Item.Art}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="22,0,0,0">
                                <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Border Background="#33FFFFFF" CornerRadius="6" Padding="8,2" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Kind}" FontSize="13" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="15" Foreground="#99A3B5" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsPoster}" Value="True">
                            <Setter TargetName="Thumb" Property="Width" Value="58" />
                            <Setter TargetName="Thumb" Property="Height" Value="86" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </Grid.Resources>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Intestazione -->
            <Grid Margin="64,36,64,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/logo.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="IPTVISION" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="Bold" Margin="16,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#262B36" CornerRadius="22" Padding="18,9" Margin="0,0,28,0" VerticalAlignment="Center"
                            Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Fill="{StaticResource LiveBrush}" VerticalAlignment="Center" />
                            <TextBlock FontSize="16" Margin="10,0,0,0" MaxWidth="420" TextTrimming="CharacterEllipsis">
                                <Run Text="In riproduzione: " Foreground="#99A3B5" /><Run Text="{Binding NowPlayingTitle, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding TvClock}" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Right"
                                   FontFamily="{StaticResource DisplayFont}" />
                        <TextBlock Text="{Binding TvDate}" FontSize="14" Foreground="#99A3B5" HorizontalAlignment="Right" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Sezioni -->
            <ItemsControl x:Name="TvTabsList" Grid.Row="1" Margin="58,30,64,0" ItemsSource="{Binding TvTabs}"
                          PreviewMouseLeftButtonUp="TvTabs_PreviewMouseLeftButtonUp">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type m:TvTab}">
                        <Border Style="{StaticResource TvPill}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="19" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding Title}" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Titolo della schermata -->
            <StackPanel Grid.Row="2" Margin="64,30,64,6">
                <TextBlock Text="{Binding TvHeading}" FontFamily="{StaticResource DisplayFont}" FontSize="38" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding TvSubheading}" FontSize="17" Foreground="#99A3B5" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding TvSubheading, Converter={StaticResource NullToVis}}" />
            </StackPanel>

            <!-- Ricerca (schermata Cerca) -->
            <Grid Grid.Row="3" Margin="64,16,64,8" Visibility="{Binding IsTvSearchScreen, Converter={StaticResource BoolToVis}}">
                <Border CornerRadius="16" BorderThickness="3" Background="#161921">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="#2E3340" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTvSearchZone}" Value="True">
                                    <Setter Property="BorderBrush" Value="White" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid Height="70">
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="24" HorizontalAlignment="Left" Margin="24,0,0,0"
                                   Foreground="#99A3B5" />
                        <TextBox x:Name="TvSearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                 Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White" FontSize="26"
                                 VerticalContentAlignment="Center" Margin="66,0,200,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,22,0" VerticalAlignment="Center">
                            <TextBlock Text="&#xE720;" Style="{StaticResource Icon}" FontSize="22" Foreground="#8FB1FF" />
                            <TextBlock Text="OK per parlare" FontSize="16" Foreground="#99A3B5" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Dettaglio serie: trama e stagioni -->
            <Grid Grid.Row="3" Margin="64,12,64,4" Visibility="{Binding IsTvSeriesScreen, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding OpenSeriesPlot}" FontSize="17" Foreground="#C8CEDA" TextWrapping="Wrap" MaxWidth="1100"
                               HorizontalAlignment="Left" MaxHeight="52" TextTrimming="WordEllipsis"
                               Visibility="{Binding OpenSeriesPlot, Converter={StaticResource NullToVis}}" />
                    <ItemsControl ItemsSource="{Binding Seasons}" Margin="-6,16,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:SeasonItem}">
                                <Border Style="{StaticResource TvPill}" Padding="20,9" Margin="6,0,6,6">
                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>

            <!-- Griglia -->
            <ListBox x:Name="TvRowsList" Grid.Row="4" ItemsSource="{Binding TvRows}" Background="Transparent" BorderThickness="0" Foreground="White"
                     Focusable="False" Padding="52,8,52,40"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.CanContentScroll="True"
                     PreviewMouseLeftButtonUp="TvRows_PreviewMouseLeftButtonUp">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type m:TvRow}">
                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" Columns="{Binding Columns}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLibraryLoading}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSeriesLoading}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ContentControl Style="{StaticResource Spinner}" />
                <TextBlock Text="Caricamento…" FontSize="18" Foreground="#99A3B5" Margin="0,16,0,0" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Legenda comandi -->
            <Border Grid.Row="5" Background="#C0080A0E" Padding="64,16">
                <StackPanel Orientation="Horizontal" TextElement.FontSize="15" TextElement.Foreground="#99A3B5">
                    <StackPanel.Resources>
                        <Style x:Key="Key" TargetType="Border">
                            <Setter Property="Background" Value="#2A2F3A" />
                            <Setter Property="CornerRadius" Value="6" />
                            <Setter Property="Padding" Value="9,3" />
                            <Setter Property="Margin" Value="0,0,10,0" />
                            <Setter Property="TextElement.Foreground" Value="White" />
                            <Setter Property="TextElement.FontWeight" Value="SemiBold" />
                        </Style>
                    </StackPanel.Resources>
                    <Border Style="{StaticResource Key}"><TextBlock Text="↑ ↓ ← →" /></Border>
                    <TextBlock Text="Muovi" VerticalAlignment="Center" Margin="0,0,30,0" />
                    <Border Style="{StaticResource Key}"><TextBlock Text="OK · A" /></Border>
                    <TextBlock Text="Apri" VerticalAlignment="Center" Margin="0,0,30,0" />
                    <Border Style="{StaticResource Key}"><TextBlock Text="Indietro · B" /></Border>
                    <TextBlock Text="Torna" VerticalAlignment="Center" Margin="0,0,30,0" />
                    <Border Style="{StaticResource Key}"><TextBlock Text="LB · RB" /></Border>
                    <TextBlock Text="Sezione" VerticalAlignment="Center" Margin="0,0,30,0" />
                    <Border Style="{StaticResource Key}"><TextBlock Text="Menu · Start" /></Border>
                    <TextBlock Text="Torna alla visione" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================= Scelta della versione ======================= -->
        <Grid x:Name="VariantLayer" Grid.RowSpan="2" Panel.ZIndex="100" Background="#B8000000"
              Visibility="{Binding ShowVariantOverlay, Converter={StaticResource BoolToVis}}"
              MouseLeftButtonUp="VariantLayer_MouseLeftButtonUp">
            <!-- Da lontano serve più grande: la scelta a schermo intero c'è solo in modalità TV. -->
            <Border Width="540" MaxHeight="600" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22,20"
                    Background="{StaticResource PanelBrush}" CornerRadius="16" BorderBrush="{StaticResource StrokeStrongBrush}" BorderThickness="1">
                <Border.LayoutTransform>
                    <ScaleTransform ScaleX="1.4" ScaleY="1.4" />
                </Border.LayoutTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Scegli la versione" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Text="{Binding VariantOwner.ItemName}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                               Margin="0,4,0,12" TextTrimming="CharacterEllipsis" />
                    <ListBox x:Name="VariantList" Grid.Row="2" ItemsSource="{Binding VariantChoices}" Style="{StaticResource LibraryList}"
                             ItemTemplate="{StaticResource VariantItemTemplate}"
                             PreviewMouseLeftButtonUp="VariantList_PreviewMouseLeftButtonUp">

                    </ListBox>
                    <TextBlock Grid.Row="3" Text="Invio o A per guardare  ·  Esc o B per annullare" Foreground="{StaticResource TextTertiaryBrush}"
                               FontSize="12" Margin="0,12,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
