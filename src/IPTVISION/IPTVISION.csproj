<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>IPTVISION</AssemblyName>
    <RootNamespace>IPTVISION</RootNamespace>
    <Product>IPTVISION</Product>
    <Version>1.28.3</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\iptvision.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>it</SatelliteResourceLanguages>
    <!-- Solo i binari VLC x64: niente cartella x86 inutile -->
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="LibVLCSharp" Version="3.9.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!-- Chiave TMDB integrata: sta in tmdb.key nella cartella del progetto, escluso da git. Senza il file l'app chiede la sua. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\tmdb.key')">
    <AssemblyMetadata Include="TmdbKey" Value="$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\tmdb.key').Trim())" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\skeuo\*.png" />
    <Resource Include="Assets\fonts\*.ttf" />
    <None Include="Assets\fonts\FONTS-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\fonts\FONTS-OFL-NOTHING.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
